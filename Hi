-- ===== DRAG FUNCTIONALITY =====
local dragging = false
local dragStart, startPos

local function makeDraggable(frame)
    local function update(input)
        local delta = input.Position - dragStart
        MainContainer.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end

    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = MainContainer.Position
            input.Changed:Wait()
            dragging = false
        end
    end)

    frame.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement 
        or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end)
end

-- Make both toggle button and drag handle movable
makeDraggable(ToggleButton)
makeDraggable(DragHandle)

-- ===== SCAN & TELEPORT =====
local function scanNPCs()
    -- Clear old list
    for _, child in ipairs(ListFrame:GetChildren()) do
        if child:IsA("TextButton") or child:IsA("TextLabel") then
            child:Destroy()
        end
    end

    local npcsFound = {}

    -- Scan workspace
    for _, descendant in ipairs(workspace:GetDescendants()) do
        local humanoid = descendant:FindFirstChildOfClass("Humanoid")
        if not humanoid then continue end

        local parentModel = descendant:IsA("Model") and descendant or descendant.Parent
        if not parentModel then continue end

        -- Skip players
        if Players:GetPlayerFromCharacter(parentModel) then continue end

        local npcRoot = humanoid.RootPart
        if npcRoot then
            table.insert(npcsFound, {
                Name = parentModel.Name,
                Position = npcRoot.Position,
                Model = parentModel
            })
        end
    end

    -- Show results
    if #npcsFound == 0 then
        local InfoLabel = Instance.new("TextLabel")
        InfoLabel.Size = UDim2.new(1, -8, 0, 30)
        InfoLabel.BackgroundTransparency = 1
        InfoLabel.Text = "No NPCs found!"
        InfoLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
        InfoLabel.Font = Enum.Font.Gotham
        InfoLabel.TextSize = 14
        InfoLabel.Parent = ListFrame
    else
        for _, npc in ipairs(npcsFound) do
            local TeleportBtn = Instance.new("TextButton")
            TeleportBtn.Size = UDim2.new(1, -8, 0, 32)
            TeleportBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
            TeleportBtn.Text = npc.Name
            TeleportBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            TeleportBtn.Font = Enum.Font.Gotham
            TeleportBtn.TextSize = 12
            TeleportBtn.AutoLocalize = false
            TeleportBtn.Parent = ListFrame

            TeleportBtn.MouseButton1Click:Connect(function()
                local char = Player.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    char.HumanoidRootPart.Position = npc.Position + Vector3.new(0, 2, 0)
                end
            end)
        end
    end

    ListFrame.Visible = true
    ToggleButton.Text = "✅ Found: " .. #npcsFound .. " (Tap to Close)"
end

-- Toggle open/close
ToggleButton.MouseButton1Click:Connect(function()
    if ListFrame.Visible then
        ListFrame.Visible = false
        ToggleButton.Text = "🔄 Scan NPCs"
    else
        scanNPCs()
    end
end)

-- Touch support for toggle
ToggleButton.Tap:Connect(function()
    if ListFrame.Visible then
        ListFrame.Visible = false
        ToggleButton.Text = "🔄 Scan NPCs"
    else
        scanNPCs()
    end
end)

-- Keyboard shortcut
UserInputService.InputBegan:Connect(function(input)
    if input.KeyCode == SCAN_KEYBIND then
        if ListFrame.Visible then
            ListFrame.Visible = false
            ToggleButton.Text = "🔄 Scan NPCs"
        else
            scanNPCs()
        end
    end
end)
